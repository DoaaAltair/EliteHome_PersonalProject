# EliteHome Backend Environment Variables
# Copy this file to .env and fill in your values

# Supabase Database Configuration
# Option 1: Use connection string (recommended for Vercel)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxx.supabase.co:5432/postgres

# Option 2: Use individual parameters (fallback)
DB_HOST=db.xxxxx.supabase.co
DB_USER=postgres
DB_PASSWORD=your_supabase_password
DB_NAME=postgres
DB_PORT=5432
DB_SSL=true

# Supabase Storage Configuration (for file uploads)
# Get these from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# ⚠️ IMPORTANT: Service role key is for backend only! NEVER expose in frontend!

# JWT Secret (use a strong, random string in production - min. 32 characters)
JWT_SECRET=your_super_secret_jwt_key_here_change_this_in_production_min_32_chars

# Server Configuration
PORT=5000

# CORS Configuration (for production)
CORS_ORIGIN=http://localhost:3000
